   "source": [
    "#TO CHECK THAT A STRING CONTAINS A CERTAIN SET OF CHARACTERS!!\n",
    "\n",
    "str = input(\"Enter a string: \")\n",
    "\n",
    "for i in str:\n",
    "    if ('a' <= i <= 'z') or ('A' <= i <= 'Z') or ('0' <= i <= '9'):\n",
    "        continue       \n",
    "    else:\n",
    "        print(\"INVALID\")\n",
    "        break\n",
    "\n",
    "else:\n",
    "    print(\"VALID\")"
   ]
  }
 ],
